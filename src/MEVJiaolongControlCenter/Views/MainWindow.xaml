                                <StackPanel>
                                    <TextBlock Text="测试目标 (可多选)" FontSize="13" Margin="0,0,0,8" Foreground="{StaticResource TextSub}"/>
                                    <WrapPanel>
                                        <ToggleButton x:Name="TargetCpu" AutomationProperties.AutomationId="TargetCpu" Style="{StaticResource StressChip}" IsChecked="True">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Chip" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="CPU 全核满载" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="TargetMemory" AutomationProperties.AutomationId="TargetMemory" Style="{StaticResource StressChip}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Memory" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="内存写入" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="TargetDisk" AutomationProperties.AutomationId="TargetDisk" Style="{StaticResource StressChip}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="HardDisk" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="硬盘读写" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="TargetGpu" AutomationProperties.AutomationId="TargetGpu" Style="{StaticResource StressChip}">
