                            <!-- 亮度 -->
                            <ContentControl Style="{StaticResource GlassCard}">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="96">
                                        <materialDesign:PackIcon Kind="Brightness7" Width="20" Height="20" Foreground="#FFD54F" VerticalAlignment="Center"/>
                                        <TextBlock Text="亮度" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0" Foreground="{StaticResource TextMain}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="BrightnessValueLabel" Text="100%" DockPanel.Dock="Right"
                                               VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#FFD54F" Margin="12,0,0,0"/>
                                    <Slider x:Name="BrightnessSlider" AutomationProperties.AutomationId="BrightnessSlider" Minimum="0" Maximum="100" Value="100"
                                            VerticalAlignment="Center" ValueChanged="BrightnessSlider_ValueChanged"/>
                                </DockPanel>
                            </ContentControl>

                            <!-- A 面 Logo 背光 -->
                            <ContentControl Style="{StaticResource GlassCard}" Margin="0,10,0,0">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Laptop" Width="20" Height="20" Foreground="#80DEEA" VerticalAlignment="Center"/>
                                        <TextBlock Text="A 面 Logo 背光" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0" Foreground="{StaticResource TextMain}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="LogoLightStatus" Text="--" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource TextSub}" Margin="0,0,10,0"/>
