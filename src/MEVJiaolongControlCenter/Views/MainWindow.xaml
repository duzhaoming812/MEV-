                            <ContentControl x:Name="StressResultCard" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="ClipboardCheck" Width="20" Height="20" Foreground="#69F0AE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="上次测试结果" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StressResultTime" Text="" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="最小" FontSize="12" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="平均" FontSize="12" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="最大" FontSize="12" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU 温度" FontSize="13" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ResTempMin" Grid.Row="1" Grid.Column="1" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="#69F0AE" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ResTempAvg" Grid.Row="1" Grid.Column="2" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="#FFD54F" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ResTempMax" Grid.Row="1" Grid.Column="3" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="#FF5252" HorizontalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU 功耗" FontSize="13" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" Margin="0,10"/>
                                        <TextBlock x:Name="ResPowerMin" Grid.Row="2" Grid.Column="1" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="ResPowerAvg" Grid.Row="2" Grid.Column="2" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="ResPowerMax" Grid.Row="2" Grid.Column="3" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="风扇转速" FontSize="13" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ResFanMin" Grid.Row="3" Grid.Column="1" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ResFanAvg" Grid.Row="3" Grid.Column="2" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="ResFanMax" Grid.Row="3" Grid.Column="3" Text="--" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ContentControl>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>

                <!-- ============ 页脚 ============ -->
                <Border Grid.Row="3" CornerRadius="12" Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                        BorderThickness="1" Padding="16,8" Margin="2,12,2,0">
                    <TextBlock x:Name="FooterText" Text="正在读取本机配置…"
                               FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource TextSub}"
                               TextTrimming="CharacterEllipsis" ToolTip="本机硬件配置(启动时从 WMI 实时读取)"/>
                </Border>
            </Grid>

            <materialDesign:Snackbar x:Name="MainSnackbar" Margin="16"
                                     Background="#E6141420" Foreground="#F4F5FA"
                                     VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                <materialDesign:Snackbar.MessageQueue>
                    <materialDesign:MessageQueue/>
                </materialDesign:Snackbar.MessageQueue>
            </materialDesign:Snackbar>
        </Grid>
    </materialDesign:DialogHost>
</Window>
