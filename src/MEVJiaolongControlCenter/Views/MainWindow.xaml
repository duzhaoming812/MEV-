<Window x:Class="MEVJiaolongControlCenter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="MEV蛟龙控制台"
        Height="780" Width="1240"
        MinHeight="660" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <!-- 自定义标题栏: Hero 即拖拽区, 双击最大化, 边缘8px可拉伸 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="8"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ============ 机械革命品牌配色: 深空黑 + 电竞红 ============ -->
        <SolidColorBrush x:Key="MechRed" Color="#FF3D5A"/>
        <SolidColorBrush x:Key="GlassStroke" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="GlassStrokeStrong" Color="#54FFFFFF"/>
        <SolidColorBrush x:Key="TextMain" Color="#F4F5FA"/>
        <SolidColorBrush x:Key="TextSub" Color="#9AA0B5"/>

        <!-- 背景: 近黑蓝紫 -->
        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="#0A0A10" Offset="0"/>
            <GradientStop Color="#0E0B17" Offset="0.5"/>
            <GradientStop Color="#080810" Offset="1"/>
        </LinearGradientBrush>

        <!-- 电竞红渐变(主强调) -->
        <LinearGradientBrush x:Key="MechAccent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4D63" Offset="0"/>
            <GradientStop Color="#E8284A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="MechAccentV" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF4D63" Offset="0"/>
            <GradientStop Color="#D61E42" Offset="1"/>
        </LinearGradientBrush>

        <!-- Hero 红粉辉光 -->
        <LinearGradientBrush x:Key="HeroGlowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5A1230" Offset="0"/>
            <GradientStop Color="#2A1030" Offset="0.55"/>
            <GradientStop Color="#3A1230" Offset="1"/>
        </LinearGradientBrush>

        <!-- 环境辉光球 -->
        <RadialGradientBrush x:Key="GlowRed" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#3AFF3D5A" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </RadialGradientBrush>

        <!-- 科技网格纹理(游戏本质感) -->
        <DrawingBrush x:Key="TechGrid" TileMode="Tile" Viewport="0,0,44,44" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,44" EndPoint="44,44"/>
                            <LineGeometry StartPoint="44,0" EndPoint="44,44"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#0AFFFFFF" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <RadialGradientBrush x:Key="GlowViolet" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#2E6A4DFF" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GlowCyan" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#2226C6DA" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </RadialGradientBrush>

        <!-- ============ 液态玻璃卡片基础模板 ============ -->
        <ControlTemplate x:Key="GlassCardTemplate" TargetType="ContentControl">
            <Grid>
                <Border x:Name="cardBd" CornerRadius="20" Background="#1AFFFFFF"
                        BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                </Border>
                <!-- 顶部高光(玻璃反光) -->
                <Border CornerRadius="20,20,0,0" Height="44" VerticalAlignment="Top"
                        Margin="1,1,1,0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1EFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- 左上 specular 光泽 -->
                <Ellipse Width="340" Height="150" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-140,-70,0,0" IsHitTestVisible="False" Opacity="0.6">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#16FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="cardBd" Property="BorderBrush" Value="{StaticResource GlassStrokeStrong}"/>
                    <Setter TargetName="cardBd" Property="Background" Value="#22FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="GlassCard" TargetType="ContentControl">
            <Setter Property="Template" Value="{StaticResource GlassCardTemplate}"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="MetricGlassCard" TargetType="ContentControl" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- 玻璃描边容器(Hero / Nav) -->
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 玻璃图标按钮(白底半透明) -->
        <Style x:Key="GlassIconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" Background="#22FFFFFF"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 功能区导航胶囊(液态玻璃) ============ -->
        <Style x:Key="ZoneNavCapsule" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="16" Padding="10,13" Background="#14FFFFFF"
                                BorderBrush="#24FFFFFF" BorderThickness="1">
                            <Grid>
                                <Border x:Name="fill" CornerRadius="15" Opacity="0"
                                        Background="{StaticResource MechAccent}"/>
                                <Border x:Name="sheen" CornerRadius="15" VerticalAlignment="Top"
                                        Height="16" Opacity="0" Background="#2EFFFFFF"/>
                                <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#24FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fill" Property="Opacity" Value="1"/>
                                <Setter TargetName="sheen" Property="Opacity" Value="1"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#66FF7A8C"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.75" Color="#99FF3D5A"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 分段/胶囊按钮(模式选择) ============ -->
        <Style x:Key="PillToggle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="14" Background="#1AFFFFFF"
                                BorderBrush="#2AFFFFFF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4DFF4D63"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource MechAccent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#66FF7A8C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 多选胶囊(压力目标) ============ -->
        <Style x:Key="StressChip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="14" Background="#1AFFFFFF"
                                BorderBrush="#2AFFFFFF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4DFF4D63"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource MechAccent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#66FF7A8C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 取色器命中层(透明按钮, 便于自动化定位) ============ -->
        <Style x:Key="PickerHit" TargetType="Button">
            <Setter Property="Cursor" Value="Cross"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 覆盖 MD 按钮样式: Tag=Raised 显示红胶囊, 否则玻璃扁平 ============ -->
        <Style x:Key="GlassButtonBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                Background="#1AFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1">
                            <Grid>
                                <Border x:Name="fill" CornerRadius="11" Opacity="0"
                                        Background="{TemplateBinding Background}"/>
                                <Border x:Name="sheen" CornerRadius="11" VerticalAlignment="Top"
                                        Height="14" Opacity="0" Background="#2EFFFFFF"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Raised">
                                <Setter TargetName="fill" Property="Opacity" Value="1"/>
                                <Setter TargetName="sheen" Property="Opacity" Value="1"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#66FF7A8C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassFlatButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}"/>

        <!-- 隐式覆盖: 使 code-behind 的 FindResource('MaterialDesignRaisedButton'/'FlatButton') 得到玻璃样式 -->
        <Style x:Key="MaterialDesignRaisedButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}">
            <!-- Tag=Raised 是模板里点亮填充色的开关; 不设它的话, 代码切换 Style 完全看不出高亮 -->
            <Setter Property="Tag" Value="Raised"/>
            <Setter Property="Background" Value="{StaticResource MechAccent}"/>
        </Style>
        <Style x:Key="MaterialDesignFlatButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}"/>

        <!-- ============ 文本/标题样式 ============ -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style x:Key="SectionAccent" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource MechAccentV}"/>
        </Style>
        <Style x:Key="SectionIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource MechRed}"/>
        </Style>
    </Window.Resources>

    <materialDesign:DialogHost>
        <Grid Background="{StaticResource BgGradient}">
            <!-- 环境辉光层 -->
            <Ellipse Width="720" Height="720" Fill="{StaticResource GlowRed}"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-200,0" IsHitTestVisible="False"/>
            <Ellipse Width="640" Height="640" Fill="{StaticResource GlowViolet}"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-220,0,0,-240" IsHitTestVisible="False"/>
            <Ellipse Width="560" Height="560" Fill="{StaticResource GlowCyan}"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-300,0,0" IsHitTestVisible="False"/>
            <!-- 科技网格覆层 -->
            <Rectangle Fill="{StaticResource TechGrid}" IsHitTestVisible="False"/>

            <Grid Margin="20,16,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ 0. Hero 横幅 ============ -->
                <Border Grid.Row="0" Style="{StaticResource GlassPanel}" CornerRadius="22"
                        Background="{StaticResource HeroGlowBrush}" Margin="2,0,2,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Border CornerRadius="22,22,0,0" Height="48" VerticalAlignment="Top" Margin="1,1,1,0"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#24FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <DockPanel Margin="22,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="HeroIconBorder" Width="52" Height="52" CornerRadius="16"
                                        Background="{StaticResource MechAccent}" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="HeroIconGlow" BlurRadius="18" ShadowDepth="2" Opacity="0.6" Color="#FF3D5A"/>
                                    </Border.Effect>
                                    <materialDesign:PackIcon Kind="LightningBolt" Width="30" Height="30"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="MEV蛟龙控制台" FontSize="23" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="MEV · 机械革命蛟龙系列控制台" FontSize="12"
                                               Foreground="#CCF0E0E6" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border x:Name="HeroModeChip" CornerRadius="14" Background="#30FFFFFF" Padding="14,7"
                                        VerticalAlignment="Center" Margin="0,0,10,0"
                                        BorderBrush="#40FFFFFF" BorderThickness="1"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon x:Name="HeroModeIcon" Kind="Speedometer" Width="14" Height="14"
                                                                 Foreground="#FF4D63" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="HeroModeText" Text="游戏模式" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#FFB74D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="14" Background="#30FFFFFF" Padding="14,7"
                                        VerticalAlignment="Center" Margin="0,0,10,0"
                                        BorderBrush="#40FFFFFF" BorderThickness="1"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#69F0AE"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource GlassIconButton}" Click="Minimize_Click" ToolTip="最小化"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <materialDesign:PackIcon Kind="WindowMinimize" Width="20" Height="20" Foreground="White"/>
                                </Button>
                                <Button Style="{StaticResource GlassIconButton}" Click="Maximize_Click" ToolTip="最大化/还原"
                                        Margin="8,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="20" Height="20" Foreground="White"/>
                                </Button>
                                <Button Style="{StaticResource GlassIconButton}" Click="Close_Click" ToolTip="关闭" Margin="8,0,0,0"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <materialDesign:PackIcon Kind="WindowClose" Width="20" Height="20" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        <!-- 底部强调线: 电竞质感 -->
                        <Border Height="2" VerticalAlignment="Bottom" Margin="26,0,26,0" CornerRadius="1"
                                Background="{StaticResource MechAccent}" Opacity="0.8" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- ============ 功能区导航(全液态玻璃) ============ -->
                <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Background="#12FFFFFF"
                        Padding="8" Margin="2,0,2,16" HorizontalAlignment="Stretch">
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="ZoneNavHome" AutomationProperties.AutomationId="ZoneNavHome" GroupName="ZoneNav" Style="{StaticResource ZoneNavCapsule}"
                                     Tag="0" IsChecked="True" Checked="ZoneNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HomeVariant" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="首页" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ZoneNavPerf" AutomationProperties.AutomationId="ZoneNavPerf" GroupName="ZoneNav" Style="{StaticResource ZoneNavCapsule}"
                                     Tag="1" Checked="ZoneNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Speedometer" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="性能" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ZoneNavLight" AutomationProperties.AutomationId="ZoneNavLight" GroupName="ZoneNav" Style="{StaticResource ZoneNavCapsule}"
                                     Tag="2" Checked="ZoneNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="KeyboardVariant" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="灯光" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ZoneNavStress" AutomationProperties.AutomationId="ZoneNavStress" GroupName="ZoneNav" Style="{StaticResource ZoneNavCapsule}"
                                     Tag="3" Checked="ZoneNav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Fire" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="压力" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>

                <!-- ============ 内容区: 各功能分区 ============ -->
                <Grid Grid.Row="2">

                    <!-- ==================== 首页 ==================== -->
                    <ScrollViewer x:Name="ZoneHome" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch" Margin="6,0">

                            <!-- 硬件监控 -->
                            <StackPanel Orientation="Horizontal" Margin="10,2,10,10">
                                <Border Style="{StaticResource SectionAccent}"/>
                                <materialDesign:PackIcon Kind="ChartLine" Style="{StaticResource SectionIcon}"/>
                                <TextBlock Text="硬件监控" Style="{StaticResource SectionHeader}"/>
