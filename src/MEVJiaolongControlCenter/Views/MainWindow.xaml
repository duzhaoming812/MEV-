                                                      Checked="LogoLight_Changed" Unchecked="LogoLight_Changed"/>
                                    </StackPanel>
                                </DockPanel>
                            </ContentControl>


                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== 压力 ==================== -->
                    <ScrollViewer x:Name="ZoneStress" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch" Margin="6,0">

                            <StackPanel Orientation="Horizontal" Margin="10,2,10,10">
                                <Border Style="{StaticResource SectionAccent}"/>
                                <materialDesign:PackIcon Kind="Fire" Style="{StaticResource SectionIcon}"/>
                                <TextBlock Text="压力测试" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>

                            <!-- 实时负载读数 -->
                            <ContentControl Style="{StaticResource GlassCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="CPU 温度" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="StressTempValue" Text="0°C" Style="{StaticResource MetricValue}" Foreground="{StaticResource MechRed}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="CPU 功耗" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="StressPowerValue" Text="0.0W" Style="{StaticResource MetricValue}" Foreground="#B388FF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="风扇转速" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="StressRpmValue" Text="0 RPM" FontSize="24" FontWeight="Bold" Foreground="#69F0AE"/>
                                    </StackPanel>
                                </Grid>
                            </ContentControl>

                            <!-- 测试目标 + 时长 + 控制 -->
