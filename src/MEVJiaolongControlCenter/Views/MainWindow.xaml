                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0">
                                        <TextBlock Text="键盘亮度 / 颜色" Style="{StaticResource MetricLabel}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="EcKbBrightnessValue" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                            <Border x:Name="EcKbColorSwatch" Width="18" Height="18" CornerRadius="9"
