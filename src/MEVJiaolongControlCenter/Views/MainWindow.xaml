                                        <Button Width="72" Height="40" Margin="0,0,8,8" Style="{StaticResource GlassFlatButton}" Padding="0"
                                            Tag="0,229,255|255,0,255|255,255,0" Click="GradientPreset_Click" ToolTip="赛博: 青→紫→黄 三色">
                                            <Border Width="56" Height="28" CornerRadius="8" BorderBrush="#55FFFFFF" BorderThickness="1">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
