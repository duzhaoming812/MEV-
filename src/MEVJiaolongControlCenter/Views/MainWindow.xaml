                                                <materialDesign:PackIcon Kind="Gamepad" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="GPU 探测" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </WrapPanel>
                                    <TextBlock x:Name="StressAdaptiveText" Text="自适应：检测本机配置…" FontSize="12"
                                               Margin="0,10,0,0" Foreground="{StaticResource TextSub}"/>

                                    <TextBlock Text="测试时长" FontSize="13" Margin="0,14,0,8" Foreground="{StaticResource TextSub}"/>
