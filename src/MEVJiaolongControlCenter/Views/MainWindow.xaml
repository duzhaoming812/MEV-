                                <TextBlock Text="快捷控制" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <ContentControl Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Brightness6" Width="20" Height="20" Foreground="#FFD54F" VerticalAlignment="Center"/>
                                            <TextBlock Text="屏幕亮度" VerticalAlignment="Center" FontSize="14" Margin="8,0,0,0" Foreground="{StaticResource TextMain}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ScreenBrightnessPercent" Text="--%" DockPanel.Dock="Right" VerticalAlignment="Center"
