                                        <ComboBox x:Name="RefreshRateCombo" Grid.Column="1" Width="140"
                                                  VerticalAlignment="Center" ItemStringFormat="{}{0} Hz"
                                                  SelectionChanged="RefreshRateCombo_SelectionChanged"/>
                                    </Grid>
                                </StackPanel>
                            </ContentControl>

                            <!-- 设备详情 -->
                            <StackPanel Orientation="Horizontal" Margin="10,4,10,10">
                                <Border Style="{StaticResource SectionAccent}"/>
                                <materialDesign:PackIcon Kind="InformationOutline" Style="{StaticResource SectionIcon}"/>
