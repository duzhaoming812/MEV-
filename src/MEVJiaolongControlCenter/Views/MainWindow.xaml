                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <materialDesign:PackIcon Kind="Gamepad" Width="16" Height="16" Foreground="#FF80AB" VerticalAlignment="Center" Margin="0,0,6,0"/>
