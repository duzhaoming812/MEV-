                                                     Padding="16,9" FontSize="13" Content="60 秒"/>
                                        <RadioButton x:Name="Dur120" GroupName="StressDur" Style="{StaticResource PillToggle}"
                                                     Padding="16,9" FontSize="13" Content="2 分钟"/>
                                        <RadioButton x:Name="Dur300" GroupName="StressDur" Style="{StaticResource PillToggle}"
                                                     Padding="16,9" FontSize="13" Content="5 分钟"/>
                                    </WrapPanel>

                                    <DockPanel Margin="0,18,0,0">
                                        <TextBlock x:Name="StressRemainText" Text="待机" VerticalAlignment="Center"
                                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSub}"/>
                                        <Button x:Name="StressButton" AutomationProperties.AutomationId="StressButton" Style="{StaticResource MaterialDesignRaisedButton}"
