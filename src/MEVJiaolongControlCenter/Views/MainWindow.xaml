                                        </StackPanel>
                                        <TextBlock x:Name="GpuMetricText" Text="--" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </ContentControl>

