                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="存储" Width="72" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="DeviceStorageText" Text="--" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextMain}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="电池/充电" Width="72" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="BatteryHealthText" Text="--" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextMain}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="GPU" Width="72" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="GpuDetailText" Text="--" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextMain}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="显示" Width="72" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="DisplayInfoText" Text="--" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextMain}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="音频" Width="72" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="AudioInfoText" Text="--" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextMain}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="网络" Width="72" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="NetworkInfoText" Text="--" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextMain}"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="系统" Width="72" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="OsInfoText" Text="--" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextMain}"/>
                                    </DockPanel>
                                </StackPanel>
                            </ContentControl>

                            <!-- CPU 核心 -->
                            <StackPanel Orientation="Horizontal" Margin="10,4,10,10">
                                <Border Style="{StaticResource SectionAccent}"/>
                                <materialDesign:PackIcon Kind="Chip" Style="{StaticResource SectionIcon}"/>
                                <TextBlock Text="CPU / 内存 / 硬盘 详细数据" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <ContentControl Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock x:Name="CpuSummaryText" Text="等待传感器数据…" FontSize="13"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextMain}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CPU 核心" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,0,0,4"/>
                                            <UniformGrid x:Name="CpuCoresGrid" Columns="2"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                            <TextBlock Text="内存" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="MemoryDetailText" FontSize="12.5" LineHeight="18"
                                                       TextWrapping="Wrap" Foreground="{StaticResource TextMain}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="18,0,0,0">
                                            <TextBlock Text="硬盘" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="StorageDetailText" FontSize="12.5" LineHeight="18"
                                                       TextWrapping="Wrap" Foreground="{StaticResource TextMain}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ContentControl>

                            <!-- 系统设置 -->
                            <StackPanel Orientation="Horizontal" Margin="10,4,10,10">
                                <Border Style="{StaticResource SectionAccent}"/>
                                <materialDesign:PackIcon Kind="Cog" Style="{StaticResource SectionIcon}"/>
                                <TextBlock Text="系统设置" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <ContentControl Style="{StaticResource GlassCard}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton IsChecked="{Binding StartWithWindows}" AutomationProperties.AutomationId="StartWithWindowsToggle"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  VerticalAlignment="Center"/>
                                    <TextBlock Text="开机自启 (最高权限)" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{StaticResource TextMain}"
                                               ToolTip="通过任务计划程序以最高权限登录时启动, 绕过UAC"/>
                                </StackPanel>
                            </ContentControl>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== 性能 ==================== -->
                    <ScrollViewer x:Name="ZonePerf" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch" Margin="6,0">

                            <!-- 性能模式 -->
                            <StackPanel Orientation="Horizontal" Margin="10,2,10,10">
                                <Border Style="{StaticResource SectionAccent}"/>
                                <materialDesign:PackIcon Kind="Speedometer" Style="{StaticResource SectionIcon}"/>
                                <TextBlock Text="性能模式" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <ContentControl Style="{StaticResource GlassCard}">
                                <UniformGrid x:Name="PerfModeGrid" Columns="3">
                                    <RadioButton GroupName="PerfMode" Style="{StaticResource PillToggle}" AutomationProperties.AutomationId="PerfModeQuiet"
                                                 ToolTip="低功耗低风扇: 办公/影音, 安静省电"
                                                 Tag="2" Click="PerfMode_Click"
                                                 IsChecked="{Binding SelectedModeIndex, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Briefcase" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="办公" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PerfMode" Style="{StaticResource PillToggle}" AutomationProperties.AutomationId="PerfModeBalanced"
                                                 ToolTip="均衡性能与噪音: 日常游戏/主流负载"
                                                 Tag="0" Click="PerfMode_Click"
                                                 IsChecked="{Binding SelectedModeIndex, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Gamepad" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="游戏" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PerfMode" Style="{StaticResource PillToggle}" AutomationProperties.AutomationId="PerfModeTurbo"
                                                 ToolTip="满功耗+风扇自动拉满: 极限性能/压力测试"
                                                 Tag="1" Click="PerfMode_Click"
                                                 IsChecked="{Binding SelectedModeIndex, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Fire" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="狂暴" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </ContentControl>

                            <!-- 显卡模式 -->
                            <StackPanel Orientation="Horizontal" Margin="10,4,10,10">
                                <Border Style="{StaticResource SectionAccent}"/>
                                <materialDesign:PackIcon Kind="MonitorDashboard" Style="{StaticResource SectionIcon}"/>
                                <TextBlock Text="显卡模式" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <ContentControl x:Name="GpuModeCard" Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <UniformGrid x:Name="GpuModeGrid" Columns="2">
                                        <RadioButton GroupName="GpuMode" Style="{StaticResource PillToggle}"
                                                     Tag="0" Click="GpuMode_Click"
                                                     IsChecked="{Binding SelectedGpuModeIndex, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Monitor" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="混合模式" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="GpuMode" Style="{StaticResource PillToggle}"
                                                     Tag="1" Click="GpuMode_Click"
                                                     IsChecked="{Binding SelectedGpuModeIndex, Mode=OneWay, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Target" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="独显直连" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBlock x:Name="GpuModeStatusText" Text="EC 回读: --" DockPanel.Dock="Left"
                                                   FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="探测物理状态" Style="{StaticResource GlassFlatButton}" Margin="0,0,8,0"
                                                    Click="VerifyGpuPhysical_Click" ToolTip="用 nvidia-smi 探测独显是否供电可通信"/>
                                            <Button Content="切独显直连并重启" Style="{StaticResource GlassFlatButton}" Margin="0,0,8,0"
                                                    Click="RebootApplyGpu_Click" ToolTip="写入EC独显直连并倒计时重启 (MUX需重启生效)"/>
                                            <Button Content="切混合并重启" Style="{StaticResource GlassFlatButton}"
                                                    Click="RebootApplyHybrid_Click" ToolTip="写入EC混合模式并倒计时重启"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </ContentControl>

                            <!-- 风扇状态(只读): 本机风扇由 EC 按温度硬件门控, 没有可用的软件调速接口 -->
                            <StackPanel Orientation="Horizontal" Margin="10,4,10,10">
                                <Border Style="{StaticResource SectionAccent}"/>
                                <materialDesign:PackIcon Kind="Fan" Style="{StaticResource SectionIcon}"/>
                                <TextBlock Text="风扇" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <ContentControl Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="当前转速" FontSize="14" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FanDetailValue" Text="-- RPM" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MechRed}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSub}"
                                               Text="本机风扇由 EC 按温度硬件门控, 没有可用的软件调速接口: 手动转速写入 EC 只存储不生效(实测), 0x14 满速开关对实测转速无可测影响。唯一真正把转速拉高的是让温度升上去——狂暴档(满功耗+满速开关)在高温下实测约 5200 RPM。所以这里只做只读显示, 不再提供无效的转速滑杆。"/>
                                </StackPanel>
                            </ContentControl>

