                                <StackPanel>
                                    <TextBlock Text="单色预设" FontSize="13" Margin="0,0,0,10" Foreground="{StaticResource TextSub}"/>
                                    <WrapPanel>
                                        <Button Width="40" Height="40" Margin="0,0,8,8" Tag="255,0,0" Click="ColorPreset_Click"
