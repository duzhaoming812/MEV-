                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock Text="调色盘 (HSV 取色)" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
