                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,14">
                                        <TextBlock Text="显卡模式" Style="{StaticResource MetricLabel}"/>
                                        <TextBlock x:Name="EcGpuModeValue" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                        <TextBlock Text="电源类型" Style="{StaticResource MetricLabel}"/>
