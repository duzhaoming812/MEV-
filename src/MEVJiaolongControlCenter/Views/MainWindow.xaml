                                            <RadioButton x:Name="EditPrimaryColor" GroupName="PickerTarget" Content="主色"
                                                         Style="{StaticResource PillToggle}" Padding="16,8" FontSize="13"
                                                         IsChecked="True" Checked="PickerTarget_Changed"/>
                                            <RadioButton x:Name="EditSecondaryColor" GroupName="PickerTarget" Content="副色"
                                                         Style="{StaticResource PillToggle}" Padding="16,8" FontSize="13"
                                                         Checked="PickerTarget_Changed"/>
