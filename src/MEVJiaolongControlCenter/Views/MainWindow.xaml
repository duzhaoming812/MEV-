                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <materialDesign:PackIcon Kind="Memory" Width="16" Height="16" Foreground="#B388FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
